[Unit]
Description=BASHER Ghost DNS Server
Documentation=https://github.com/cannaseedus-bot/BASHER
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/basher/ghost-server
ExecStart=/usr/bin/python3 index.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=basher-ghost

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/basher/ghost-server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# DNS requires port 53, which needs root or CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
