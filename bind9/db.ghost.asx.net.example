;
; DNS Zone file for ghost.asx.net
; This is a reference example if you want to run full authoritative DNS
; For the tunnel, the forward-only zone is the important part.
;
$TTL 300
@   IN SOA  ns1.ghost.asx.net. hostmaster.ghost.asx.net. (
        2025111901 ; serial (YYYYMMDDNN)
        3600       ; refresh (1 hour)
        900        ; retry (15 minutes)
        1209600    ; expire (2 weeks)
        300 )      ; minimum (5 minutes)

; Name servers
    IN NS   ns1.ghost.asx.net.
    IN NS   ns2.ghost.asx.net.

; A records for name servers
ns1 IN A    203.0.113.10
ns2 IN A    203.0.113.11

; Main domain
@   IN A    203.0.113.10
ghost IN A  203.0.113.10

; Wildcard for SCXQ2 tunnel queries
; All subdomains will resolve to the Ghost DNS engine
*   IN A    203.0.113.10

; Optional: TXT record for identification
@   IN TXT  "ASX BASHER Ghost Network v4.0"
